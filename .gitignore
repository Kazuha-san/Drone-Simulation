# --- Python engine ---------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Node / Vite frontend --------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
.eslintcache
*.tsbuildinfo

# --- Vercel ----------------------------------------------------------------
.vercel/

# --- Logs & debug ----------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment -----------------------------------------------------------
.env
.env.*
!.env.example

# --- Editors / OS ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~

# ---------------------------------------------------------------------------
# NOT ignored, deliberately:
#
#   data/bhopal_map.json
#   frontend/src/data/trace.json
#   frontend/src/data/bhopal_basemap.json
#
# These are generated by the Python engine (build_graph.py / run_simulation.py)
# but MUST stay committed. Vercel builds from git and has no Python runtime, so
# if they were ignored the deploy build could not produce them and would fail.
# Regenerate and re-commit them whenever the engine or map changes.
# ---------------------------------------------------------------------------
